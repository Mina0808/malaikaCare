{
  "pages": {
    "/global-error": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/global-error.js"
    ],
    "/(user)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(user)/page.css",
      "static/chunks/app/(user)/page.js"
    ],
    "/(user)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(user)/layout.js"
    ],
    "/(user)/loading": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(user)/loading.js"
    ],
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/layout.css",
      "static/chunks/app/layout.js"
    ]
  }
}