generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
} 

model Documents {
  id           Int       @id @unique @default(autoincrement())
  name         String
  alias        String?
  type         String
  date         DateTime  @default(now())
  requestId    Int?
  targetPage   String?
  request      Request?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Request {
  id                  Int       @id @unique @default(autoincrement())
  name                String
  type                String
  status              String
  text                String       @db.Text
  contactLastName     String?
  contactFirstName    String?
  contactEmail        String?
  contactPhone        String?
  date                DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  documents           Documents[]
  clientId            String?
  client              Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Client {
  id                  String         @id @default(cuid())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  firstName           String
  lastName            String
  phone               String
  email               String         @unique
  address             String?
  city                String?
  gender              Boolean       //true sexe féminin
  birthday            DateTime
  pathology           String?
  autonomy            Boolean
  comments            String?        @db.Text
  contactLastName     String?
  contactFirstName    String?
  contactEmail        String?
  contactPhone        String?
  role                String
  password            String?
  status              String
  professionalId      String?
  professional        Professional?    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  requests            Request[]
  documents           Documents[]
  interventions       Intervention[]
}

model Professional {
  id                String         @id @default(cuid())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  firstName         String
  lastName          String
  phone             String
  email             String         @unique
  role              String
  password          String
  status            String
  speciality        String? //medecin spécialité
  diplomas          Boolean //medecin toujours true
  assistant         Boolean //medecin toujours true
  workAddress       String?
  address           String?
  clients           Client[]
  interventions     Intervention[]
}

model Intervention {
  id                String         @id @default(cuid())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  service           String
  address           String
  startDate         DateTime
  endDate           DateTime
  status            String
  professional      Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId    String?
  patients          Client[]
}

model ActionLog {
  id            Int     @id @unique @default(autoincrement()) 
  entityName    String?
  entityId      Int 
  actionDetails String?
  ipAddress     String?
  timestamp     DateTime
}
